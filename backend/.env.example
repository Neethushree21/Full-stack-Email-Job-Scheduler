# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=ejs_session

# ---------------------------------------------------------------------------
# PostgreSQL (via Prisma)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://scheduler_user:scheduler_pass@localhost:5432/email_scheduler?schema=public"

# ---------------------------------------------------------------------------
# Redis (BullMQ + rate-limit counters + throttle locks)
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Elasticsearch
# ---------------------------------------------------------------------------
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=emails

# ---------------------------------------------------------------------------
# BullMQ Worker tuning
# ---------------------------------------------------------------------------
# How many jobs a single worker process may run concurrently.
WORKER_CONCURRENCY=5
# Minimum gap enforced between two email sends FROM THE SAME SENDER, in ms.
MIN_SEND_DELAY_MS=2000
# Default hourly cap applied to a sender when none is configured per-tenant.
DEFAULT_MAX_EMAILS_PER_HOUR=200
# Per-sender overrides, JSON map of senderId -> max/hour. Optional.
# Example: {"sender-a":100,"sender-b":500}
MAX_EMAILS_PER_HOUR_PER_SENDER={}

# ---------------------------------------------------------------------------
# Ethereal Email (fake SMTP) - https://ethereal.email
# Leave blank to auto-generate a throwaway Ethereal test account on boot.
# ---------------------------------------------------------------------------
ETHEREAL_USER=
ETHEREAL_PASS=

# ---------------------------------------------------------------------------
# Google OAuth (frontend uses NextAuth; backend verifies the ID token)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ---------------------------------------------------------------------------
# Slack OAuth ("Connect Slack" button + rate-limit alert webhook)
# ---------------------------------------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
